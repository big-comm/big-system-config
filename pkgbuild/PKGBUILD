# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=biglinux-settings
pkgdesc="Scripts and configuration files created in GTK4 that simplify switching BigLinux operation."
depends=('gtk4' 'libadwaita' 'networkmanager' 'polkit' 'python' 'python-gobject' 'systemd' 'util-linux')
makedepends=('gettext' 'git' 'python-pytest' 'python-ruff' 'shellcheck')
optdepends=(
    'baloo: KDE file indexer toggle'
    'curl: verified downloads for optional AI integrations'
    'git: install ComfyUI from a tagged release'
    'grub: GRUB timeout and kernel parameter toggles'
    'kconfig: KDE configuration toggles'
    'mkinitcpio: initramfs rebuild after boot animation changes'
    'numlockx: NumLock startup toggle'
    'p7zip: install the Krita AI plugin archive'
    'plymouth: boot animation message toggle'
    'power-profiles-daemon: CPU performance profile toggle'
    'qt6-tools: qdbus6 support for KDE checks'
    'upower: suspend at a configured critical battery level'
    'xfconf: XFCE automatic suspend configuration'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-3.0-or-later')
url="https://github.com/big-comm/${pkgname}"
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')
backup=('etc/biglinux/sleep.conf')

check() {
    cd "${srcdir}/${pkgname}"
    # The tests import modules from usr/: never leave bytecode or pytest
    # caches in the tree that package() copies into the package.
    PYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider
    ruff check usr tests locale/normalize-po-header.py
    find usr/share/biglinux/biglinux-settings locale -name '*.sh' -print0 | xargs -0 shellcheck --severity=warning
    find usr/share/biglinux/biglinux-settings locale -name '*.sh' -print0 | xargs -0 -n1 bash -n
    msgfmt --check-format --output-file=/dev/null locale/biglinux-settings.pot
    for po in locale/*.po; do
        msgfmt --check --output-file=/dev/null "$po"
    done
}

package() {
    cd "${srcdir}/${pkgname}"

    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${dir}" ]; then
            cp -a --no-preserve=ownership "${dir}" "${pkgdir}/"
        fi
    done
    # Python bytecode is generated at runtime on the target system; shipping it
    # conflicts with the .pyc files already created there by the sleep hook.
    find "${pkgdir}" \( -name '__pycache__' -o -name '.pytest_cache' -o -name '.ruff_cache' -o -name '.mypy_cache' \) \
        -prune -exec rm -rf -- {} +
    find "${pkgdir}" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
    printf '%s\n' "$pkgver" > "${pkgdir}/usr/share/biglinux/biglinux-settings/VERSION"
    chown -R root:root "${pkgdir}"

    # Install license file if present
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
