#: usr/share/biglinux/biglinux-settings/sleep_page.py:73
msgid "Choose when inactivity and low battery may suspend the system."
msgstr ""
"Veldu hvenær aðgerðaleysi og lítil rafhlaða geta sett kerfið í biðstöðu."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:80
msgid "Disable idle suspend while plugged in"
msgstr ""
"Slökkva á biðstöðu vegna aðgerðaleysis þegar tölvan er tengd við rafmagn"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 81
#: usr/share/biglinux/biglinux-settings/sleep_page.py:81
msgid "Disables automatic suspend caused by inactivity on AC power."
msgstr ""
"Slekkur á sjálfvirkri biðstöðu vegna aðgerðaleysis þegar tengt er við AC "
"rafmagn."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:88
msgid "Disable idle suspend on battery"
msgstr ""
"Slökkva á biðstöðu vegna aðgerðaleysis þegar tölvan gengur fyrir rafhlöðu"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 89
#: usr/share/biglinux/biglinux-settings/sleep_page.py:89
msgid "Keeps the system awake on battery until a critical level is reached."
msgstr "Heldur kerfinu vakandi á rafhlöðu þar til mikilvægu stigi er náð."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 96
#: usr/share/biglinux/biglinux-settings/sleep_page.py:96
msgid "Suspend only when battery reaches 20%"
msgstr "Settu aðeins í biðstöðu þegar rafhlaðan nær 20%"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 98
#: usr/share/biglinux/biglinux-settings/sleep_page.py:98
msgid ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."
msgstr ""
"Slekkur á biðstöðu vegna aðgerðaleysis á rafhlöðu og setur sjálfkrafa í "
"biðstöðu þegar hleðslan nær 20%."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 104
#: usr/share/biglinux/biglinux-settings/sleep_page.py:104
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"Þetta notar UPower mikilvæga rafhlöðustefnu. Lág- og mikilvæg viðvörun á sér "
"stað áður en biðstaða hefst við 20%."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 75
#: usr/share/biglinux/biglinux-settings/sleep_page.py:112
msgid "Sleep Mode"
msgstr "Svefnstilling"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 76
#: usr/share/biglinux/biglinux-settings/sleep_page.py:113
msgid "Configure how the system suspends."
msgstr "Stillir hvernig kerfið hvílir."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 83
#: usr/share/biglinux/biglinux-settings/sleep_page.py:120
msgid "Use s2idle (light sleep)"
msgstr "Notaðu s2idle (létt svefn)"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 85
#: usr/share/biglinux/biglinux-settings/sleep_page.py:122
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Notar léttari svefnstilling sem varðveitir Fn takka og tækjustöðu. Mælt með "
"ASUS fartölvum."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 91
#: usr/share/biglinux/biglinux-settings/sleep_page.py:128
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"S3 djúpur svefn getur valdið því að innbyggði stjórnandinn hætti að búa til "
"heitlyklaskipti. s2idle heldur EC virkum, forðast þetta vandamál með litlu "
"kostnaði í rafhlöðuframleiðslu."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 100
#: usr/share/biglinux/biglinux-settings/sleep_page.py:137
msgid "WiFi"
msgstr "WiFi"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 101
#: usr/share/biglinux/biglinux-settings/sleep_page.py:138
msgid "Prevent WiFi issues after suspend."
msgstr "Forðast WiFi vandamál eftir að hvíld er lokið."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 108
#: usr/share/biglinux/biglinux-settings/sleep_page.py:145
msgid "Protect WiFi on suspend"
msgstr "Vernda WiFi í hvíldartímabili"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 110
#: usr/share/biglinux/biglinux-settings/sleep_page.py:147
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Hindrar Realtek WiFi örgjörvuna frá því að slökkva alveg á sér (d3cold), "
"forðast tengingarleysi eftir að endurræsa."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 116
#: usr/share/biglinux/biglinux-settings/sleep_page.py:153
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Sumir Realtek RTL8852BE/CE örgjörvar mistakast við að endurstillast eftir "
"d3cold rafmagns lokun. Þetta heldur örgjörvanum í d3hot (PCIe tenging "
"lifandi) meðan á hvíld stendur."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 124
#: usr/share/biglinux/biglinux-settings/sleep_page.py:161
msgid "Display and Keyboard"
msgstr "Sýning og Tölvutakki"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 125
#: usr/share/biglinux/biglinux-settings/sleep_page.py:162
msgid "Preserve brightness and LED state across suspend."
msgstr "Vernda birtu og LED ástand yfir hvíld."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 132
#: usr/share/biglinux/biglinux-settings/sleep_page.py:169
msgid "Save/restore brightness on suspend"
msgstr "Vista/endurðu birtu við hvíld"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 134
#: usr/share/biglinux/biglinux-settings/sleep_page.py:171
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores them"
" on resume."
msgstr ""
"Sparar skjábirta og lyklaborðs LED-ljós áður en kerfið fer í dvala og "
"endurheimtir þau við endurvakningu."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 144
#: usr/share/biglinux/biglinux-settings/sleep_page.py:181
