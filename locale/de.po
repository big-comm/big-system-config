#: usr/share/biglinux/biglinux-settings/performance_page.py:101
msgid "Keeps the S.M.A.R.T. service watching disks for signs of failure."
msgstr ""
"Lässt den S.M.A.R.T.-Dienst die Festplatten auf Anzeichen von Ausfällen "
"überwachen."

#: usr/share/biglinux/biglinux-settings/performance_page.py:104
msgid "SMART"
