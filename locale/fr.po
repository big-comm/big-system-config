#: usr/share/biglinux/biglinux-settings/sleep_page.py:97
msgid "Stay awake on battery"
msgstr "Rester allumé sur batterie"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:99
msgid ""
"Does not suspend when idle on battery. The critical-battery action still "
"applies."
msgstr ""
"Ne se met pas en veille en cas d’inactivité sur batterie. L’action de "
"batterie critique s’applique toujours."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:104
#: usr/share/biglinux/biglinux-settings/sleep_page.py:120
#: usr/share/biglinux/biglinux-settings/sleep_page.py:164
msgid "battery"
msgstr "batterie"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:109
msgid "Stay awake and suspend at 20% battery"
msgstr "Rester allumé et se mettre en veille à 20 % de batterie"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:111
msgid ""
"Does not suspend when idle on battery and suspends automatically when the "
"charge reaches 20%."
msgstr ""
"Ne se met pas en veille en cas d’inactivité sur batterie et se met en veille "
"automatiquement lorsque la charge atteint 20 %."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 104
#: usr/share/biglinux/biglinux-settings/sleep_page.py:117
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"Utilise la politique de batterie critique d'UPower. Des avertissements de "
"niveau bas et critique se produisent avant l'action de suspension à 20 %."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:120
msgid "low battery"
msgstr "batterie faible"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:125
msgid "When the lid is closed"
msgstr "À la fermeture du capot"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:126
msgid ""
"Keep the computer working with the lid closed, for example with an external "
"monitor."
msgstr ""
"Garde l’ordinateur en fonctionnement capot fermé, par exemple avec un écran "
"externe."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:131
msgid "laptop"
msgstr "portable"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:131
msgid "lid"
msgstr "capot"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:135
msgid "Keep running with the lid closed while plugged in"
msgstr ""
"Continuer à fonctionner avec le couvercle fermé lorsque l’appareil est "
"branché"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:137
msgid ""
"Closing the lid will not lock or suspend the computer while it is connected "
"to power. The session and network stay active."
msgstr ""
"Fermer le capot ne verrouillera ni ne mettra en veille l’ordinateur tant "
"qu’il est branché sur secteur. La session et le réseau restent actifs."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:143
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate. Keep the notebook ventilated while it runs with the lid "
"closed."
msgstr ""
"Cela empêche la mise en veille et le verrouillage déclenchés par la fermeture"
" du couvercle. Le verrouillage automatique en cas d’inactivité reste "
"indépendant. Veillez à ce que l’ordinateur portable soit bien ventilé "
"lorsqu’il fonctionne avec le couvercle fermé."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:152
msgid "Keep running with the lid closed on battery"
msgstr "Continuer à fonctionner avec le couvercle fermé sur batterie"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:154
msgid ""
"Closing the lid will not lock or suspend the computer on battery. The session"
" and network stay active, using more battery."
msgstr ""
"Fermer le capot ne verrouillera ni ne mettra en veille l’ordinateur sur "
"batterie. La session et le réseau restent actifs, ce qui consomme davantage "
"de batterie."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:160
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate, and the 20% critical battery policy still applies."
msgstr ""
"Cela empêche la mise en veille et le verrouillage déclenchés par la fermeture"
" du couvercle. Le verrouillage automatique en cas d’inactivité reste "
"indépendant, et la politique relative au seuil critique de batterie de 20 % "
"continue de s’appliquer."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:169
msgid "Fix problems after resume"
msgstr "Corriger les problèmes après la reprise"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:170
msgid ""
"Compatibility fixes for problems some computers have when waking from "
"suspend."
msgstr ""
"Correctifs de compatibilité pour les problèmes que rencontrent certains "
"ordinateurs au réveil de la veille."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:179
msgid "Light sleep (s2idle)"
msgstr "Veille légère (s2idle)"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:181
msgid ""
"Uses a lighter sleep mode that keeps the Fn keys working after resume on some"
" ASUS notebooks. Uses slightly more battery while suspended."
msgstr ""
"Utilise un mode de veille plus léger qui maintient les touches Fn "
"fonctionnelles après la reprise sur certains portables ASUS. Consomme un peu "
"plus de batterie pendant la veille."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 91
#: usr/share/biglinux/biglinux-settings/sleep_page.py:188
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"Le mode de veille profonde S3 peut amener le Contrôleur Intégré à cesser de "
"générer des interruptions de touches de raccourci. Le s2idle maintient l'EC "
"alimenté, évitant ce problème à un coût réduit en consommation de batterie."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:192
msgid "Fn keys"
msgstr "touches Fn"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:192
msgid "hotkeys"
msgstr "raccourcis clavier"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:200
msgid "Avoid losing Wi-Fi after resume"
msgstr "Éviter la perte du Wi-Fi après la reprise"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:202
msgid ""
"Compatibility fix for some Realtek Wi-Fi adapters: keeps the adapter from "
"fully powering off during suspend, so the connection works after resume."
msgstr ""
"Correctif de compatibilité pour certains adaptateurs Wi-Fi Realtek : empêche "
"l’adaptateur de s’éteindre complètement pendant la veille, afin que la "
"connexion fonctionne après la reprise."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 116
#: usr/share/biglinux/biglinux-settings/sleep_page.py:209
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Certains chips Realtek RTL8852BE/CE échouent à se réinitialiser après un "
"arrêt d'alimentation d3cold. Cela maintient le chip en d3hot (lien PCIe "
"actif) pendant la suspension."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:213
