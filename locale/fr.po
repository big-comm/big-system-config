msgstr ""
"Désactive la mise en veille automatique due à l'inactivité sur secteur."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:88
msgid "Disable idle suspend on battery"
msgstr "Désactiver la mise en veille en cas d’inactivité sur batterie"

