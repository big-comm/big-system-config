#: usr/share/biglinux/biglinux-settings/usability_page.py:37
msgid "backlight"
msgstr "taustavalgus"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:226
msgid "brightness"
msgstr "eredus"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:233
msgid "Restart failed extensions after resume"
msgstr "Taaskäivita tõrkunud laiendused pärast ärkamist"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:235
msgid ""
