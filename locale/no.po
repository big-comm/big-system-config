msgid "Disk health monitoring"
msgstr "Overvåking av diskhelse"

#: usr/share/biglinux/biglinux-settings/performance_page.py:102
msgid ""
"Keeps the S.M.A.R.T. service watching disks for signs of failure. Installs "
"smartmontools if it is missing."
msgstr ""
"Lar S.M.A.R.T.-tjenesten overvåke diskene for tegn på feil. Installerer "
"smartmontools hvis det mangler."

#: usr/share/biglinux/biglinux-settings/performance_page.py:106
msgid "SMART"
