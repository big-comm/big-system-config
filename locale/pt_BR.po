msgstr "Librewolf"

#: usr/share/biglinux/biglinux-settings/preload_page.py:23
msgid "Palemoon"
msgstr "Palemoon"

#: usr/share/biglinux/biglinux-settings/preload_page.py:24
msgid "Opera"
msgstr "Opera"

#: usr/share/biglinux/biglinux-settings/preload_page.py:25
