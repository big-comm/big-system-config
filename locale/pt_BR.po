msgstr "Libreoffice"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:72
msgid "Automatic Suspend"
msgstr "Suspensão automática"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:73
msgid "Choose when inactivity and low battery may suspend the system."
msgstr ""
"Escolha quando a inatividade e a bateria baixa podem suspender o sistema."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:80
msgid "Disable idle suspend while plugged in"
msgstr ""
"Desativar a suspensão por inatividade enquanto estiver conectado à tomada"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:81
msgid "Disables automatic suspend caused by inactivity on AC power."
msgstr ""
"Desativa a suspensão automática por inatividade enquanto estiver na tomada."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:88
msgid "Disable idle suspend on battery"
msgstr "Desativar a suspensão por inatividade ao usar a bateria"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:89
msgid "Keeps the system awake on battery until a critical level is reached."
msgstr "Mantém o sistema ativo na bateria até que ela atinja um nível crítico."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:96
msgid "Suspend only when battery reaches 20%"
msgstr "Suspender somente quando a bateria chegar a 20%"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:98
msgid ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."
msgstr ""
"Desativa a suspensão por inatividade na bateria e suspende automaticamente "
"quando a carga chega a 20%."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:104
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"Isso usa a política de bateria crítica do UPower. Os avisos de bateria baixa "
"e crítica aparecem antes da suspensão em 20%."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:112
msgid "Sleep Mode"
msgstr "Modo de Suspensão"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:113
msgid "Configure how the system suspends."
msgstr "Configurar como o sistema suspende."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:120
msgid "Use s2idle (light sleep)"
msgstr "Usar s2idle (suspensão leve)"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:122
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Usa um modo de suspensão mais leve que preserva as teclas Fn e o estado do "
"dispositivo. Recomendado para notebooks ASUS."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:128
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"A suspensão profunda S3 pode fazer com que o Controlador Embarcado pare de "
"gerar interrupções de teclas de atalho. O s2idle mantém o EC alimentado, "
"evitando esse problema com um pequeno custo no consumo de bateria."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:137
msgid "WiFi"
msgstr "WiFi"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:138
msgid "Prevent WiFi issues after suspend."
msgstr "Evitar problemas de WiFi após a suspensão."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:145
msgid "Protect WiFi on suspend"
msgstr "Proteger WiFi na suspensão"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:147
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Impede que o chip WiFi Realtek desligue completamente (d3cold), evitando "
"perda de conexão após a retomada."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:153
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Alguns chips Realtek RTL8852BE/CE falham ao reinicializar após o bloqueio de "
"energia d3cold. Isso mantém o chip em d3hot (link PCIe ativo) durante a "
"suspensão."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:161
msgid "Display and Keyboard"
msgstr "Tela e Teclado"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:162
msgid "Preserve brightness and LED state across suspend."
msgstr "Preservar o brilho e o estado dos LEDs durante a suspensão."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:169
msgid "Save/restore brightness on suspend"
msgstr "Salvar/restaurar brilho ao suspender"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:171
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores them"
" on resume."
msgstr ""
"Salva o brilho da tela e LEDs do teclado antes de suspender e os restaura ao "
"retomar."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:181
msgid "GNOME Shell Extensions"
msgstr "Extensões do GNOME Shell"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:182
msgid "Automatic health check after resume."
msgstr "Verificação automática de integridade após retomar."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:189
msgid "Extension health monitor"
msgstr "Monitor de integridade de extensões"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:191
msgid ""
"Detects GNOME Shell extensions in error state after resume and automatically "
"restarts them."
msgstr ""
"Detecta extensões do GNOME Shell em estado de erro após retomar e as reinicia"
" automaticamente."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:200
msgid "Lid Switch"
msgstr "Tampa do notebook"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:201
msgid "Laptop lid close behavior."
msgstr "Comportamento ao fechar a tampa do notebook."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:208
msgid "Keep running with the lid closed while plugged in"
msgstr ""
"Continuar funcionando com a tampa fechada enquanto estiver conectado à tomada"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:210
msgid ""
"Keeps the session and network active when the lid is closed on AC power."
msgstr ""
"Mantém a sessão e a rede ativas quando a tampa está fechada e o notebook está"
" conectado à tomada."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:216
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate. Keep the notebook ventilated while it runs with the lid "
"closed."
msgstr ""
"Isso impede que o fechamento da tampa acione a suspensão e o bloqueio. O "
"bloqueio automático por inatividade continua sendo uma configuração separada."
" Mantenha o notebook bem ventilado enquanto ele estiver funcionando com a "
"tampa fechada."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:224
msgid "Keep running with the lid closed on battery"
msgstr "Continuar funcionando com a tampa fechada ao usar a bateria"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:226
msgid ""
"Keeps the session and network active when the lid is closed on battery power."
msgstr ""
"Mantém a sessão e a rede ativas quando a tampa está fechada e o notebook está"
" usando a bateria."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:232
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate, and the 20% critical battery policy still applies."
msgstr ""
"Isso impede que o fechamento da tampa acione a suspensão e o bloqueio. O "
"bloqueio automático por inatividade continua sendo uma configuração separada,"
" e a política de bateria crítica em 20% continua sendo aplicada."

#: usr/share/biglinux/biglinux-settings/system_page.py:13
msgid "General system settings."
msgstr "Configurações gerais do sistema."

#: usr/share/biglinux/biglinux-settings/system_page.py:19
msgid "SSH"
msgstr "SSH"

#: usr/share/biglinux/biglinux-settings/system_page.py:20
msgid "Enable remote access via ssh."
msgstr "Ativar acesso remoto via SSH."

#: usr/share/biglinux/biglinux-settings/system_page.py:23
#, python-brace-format
msgid "SSH Address: {}"
msgstr "Endereço SSH: {}"

#: usr/share/biglinux/biglinux-settings/system_page.py:27
msgid "SSH always on"
msgstr "SSH sempre ativo"

#: usr/share/biglinux/biglinux-settings/system_page.py:28
msgid "Turn on ssh remote access at boot."
msgstr "Ativar acesso remoto SSH na inicialização."

#: usr/share/biglinux/biglinux-settings/system_page.py:37
msgid "Fast Grub"
msgstr "Grub Rápido"

#: usr/share/biglinux/biglinux-settings/system_page.py:38
msgid "Decreases grub display time."
msgstr "Reduz o tempo de exibição do Grub."

#: usr/share/biglinux/biglinux-settings/system_page.py:47
msgid "Boot messages"
msgstr "Mensagens de inicialização"

#: usr/share/biglinux/biglinux-settings/system_page.py:48
msgid "Show system messages below the boot animation."
msgstr "Exibir mensagens do sistema abaixo da animação de inicialização."

#: usr/share/biglinux/biglinux-settings/system_page.py:57
msgid "Auto-mount Partitions"
msgstr "Montar partições automaticamente"

#: usr/share/biglinux/biglinux-settings/system_page.py:58
msgid "Auto mount partitions in internal disks on boot."
msgstr "Montar automaticamente partições em discos internos na inicialização."

#: usr/share/biglinux/biglinux-settings/usability_page.py:12
msgid "User and Visual system settings."
msgstr "Configurações do sistema de usuário e visuais."

#: usr/share/biglinux/biglinux-settings/usability_page.py:19
msgid "NumLock"
msgstr "NumLock"

#: usr/share/biglinux/biglinux-settings/usability_page.py:20
msgid "Initial NumLock state. Ignored if autologin is enabled."
msgstr ""
"Estado inicial do NumLock. Ignorado se o login automático estiver ativado."

#: usr/share/biglinux/biglinux-settings/usability_page.py:28
msgid "Keyboard Light"
msgstr "Luz do teclado"

#: usr/share/biglinux/biglinux-settings/usability_page.py:30
msgid ""
"Keep the keyboard backlight on. For keyboards whose light is controlled by "
"the Scroll Lock LED."
msgstr ""
"Mantém a iluminação do teclado acesa. Para teclados cuja luz é controlada "
"pelo LED do Scroll Lock."

#: usr/share/biglinux/biglinux-settings/usability_page.py:39
msgid "Window Button On Left Side"
msgstr "Botões da janela no lado esquerdo"

#: usr/share/biglinux/biglinux-settings/usability_page.py:40
msgid "Maximize, minimize, and close buttons on the left side of the window."
msgstr "Botões de maximizar, minimizar e fechar no lado esquerdo da janela."

#: usr/share/biglinux/biglinux-settings/usability_page.py:48
msgid "KZones"
msgstr "KZones"

#: usr/share/biglinux/biglinux-settings/usability_page.py:50
msgid "Enable window tiling zones for the KDE Plasma desktop."
msgstr "Ativar zonas de mosaico de janelas para a área de trabalho KDE Plasma."

#: usr/share/biglinux/biglinux-settings/usability_page.py:59
msgid "Recent Files & Locations"
msgstr "Arquivos e Locais Recentes"

#: usr/share/biglinux/biglinux-settings/usability_page.py:61
msgid ""
"Restores the 'Recent Files' and 'Recent Locations' functionality that appears"
" empty in Dolphin and the Application Menu."
msgstr ""
"Restaura a funcionalidade 'Arquivos Recentes' e 'Locais Recentes' que aparece"
" vazia no Dolphin e no Menu de Aplicativos."

