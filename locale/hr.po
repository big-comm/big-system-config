msgstr "Zaštiti WiFi tijekom suspenzije"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 110
#: usr/share/biglinux/biglinux-settings/sleep_page.py:147
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Sprječava da Realtek WiFi čip potpuno isključi napajanje (d3cold), čime se "
"izbjegava gubitak veze nakon ponovnog pokretanja."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 116
#: usr/share/biglinux/biglinux-settings/sleep_page.py:153
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Neki Realtek RTL8852BE/CE čipovi ne uspijevaju ponovno inicijalizirati nakon "
"d3cold isključivanja napajanja. To drži čip u d3hot (PCIe veza aktivna) "
"tijekom suspenzije."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 124
#: usr/share/biglinux/biglinux-settings/sleep_page.py:161
msgid "Display and Keyboard"
msgstr "Prikaz i tipkovnica"

