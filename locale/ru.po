# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 72
#: usr/share/biglinux/biglinux-settings/sleep_page.py:72
msgid "Automatic Suspend"
msgstr "Автоматический режим сна"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 73
#: usr/share/biglinux/biglinux-settings/sleep_page.py:73
msgid "Choose when inactivity and low battery may suspend the system."
msgstr ""
"Выберите, когда система может переходить в режим сна при бездействии и низком"
" заряде батареи."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:80
msgid "Disable idle suspend while plugged in"
msgstr ""
"Отключить переход в спящий режим при бездействии во время работы от сети"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 81
#: usr/share/biglinux/biglinux-settings/sleep_page.py:81
msgid "Disables automatic suspend caused by inactivity on AC power."
msgstr ""
"Отключает автоматический режим сна при бездействии при питании от сети."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:88
msgid "Disable idle suspend on battery"
msgstr ""
"Отключить переход в спящий режим при бездействии во время работы от "
"аккумулятора"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 89
#: usr/share/biglinux/biglinux-settings/sleep_page.py:89
msgid "Keeps the system awake on battery until a critical level is reached."
msgstr ""
"Оставляет систему активной при питании от батареи до достижения критического "
"уровня заряда."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 96
#: usr/share/biglinux/biglinux-settings/sleep_page.py:96
msgid "Suspend only when battery reaches 20%"
msgstr "Переходить в режим сна только при заряде батареи 20%"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 98
#: usr/share/biglinux/biglinux-settings/sleep_page.py:98
msgid ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."
msgstr ""
"Отключает режим сна при бездействии от батареи и автоматически переводит "
"систему в режим сна при достижении заряда 20%."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 104
#: usr/share/biglinux/biglinux-settings/sleep_page.py:104
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"Используется политика критического заряда батареи UPower. Предупреждения о "
"низком и критическом уровне заряда появляются до перехода в режим сна при "
"20%."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 75
#: usr/share/biglinux/biglinux-settings/sleep_page.py:112
msgid "Sleep Mode"
msgstr "Режим сна"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 76
#: usr/share/biglinux/biglinux-settings/sleep_page.py:113
msgid "Configure how the system suspends."
msgstr "Настройте, как система приостанавливается."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 83
#: usr/share/biglinux/biglinux-settings/sleep_page.py:120
msgid "Use s2idle (light sleep)"
msgstr "Использовать s2idle (легкий сон)"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 85
#: usr/share/biglinux/biglinux-settings/sleep_page.py:122
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Использует более легкий режим сна, который сохраняет клавиши Fn и состояние "
"устройства. Рекомендуется для ноутбуков ASUS."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 91
#: usr/share/biglinux/biglinux-settings/sleep_page.py:128
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"Режим глубокого сна S3 может привести к тому, что Встроенный Контроллер "
"перестанет генерировать прерывания горячих клавиш. Режим s2idle поддерживает "
"питание ВК, избегая этой проблемы при небольших затратах энергии батареи."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 100
#: usr/share/biglinux/biglinux-settings/sleep_page.py:137
msgid "WiFi"
msgstr "Wi-Fi"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 101
#: usr/share/biglinux/biglinux-settings/sleep_page.py:138
msgid "Prevent WiFi issues after suspend."
msgstr "Предотвратить проблемы с WiFi после приостановки."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 108
#: usr/share/biglinux/biglinux-settings/sleep_page.py:145
msgid "Protect WiFi on suspend"
msgstr "Защитить WiFi в режиме ожидания"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 110
#: usr/share/biglinux/biglinux-settings/sleep_page.py:147
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Предотвращает полное отключение чипа WiFi Realtek (d3cold), избегая потери "
"соединения после возобновления."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 116
#: usr/share/biglinux/biglinux-settings/sleep_page.py:153
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Некоторые чипы Realtek RTL8852BE/CE не могут повторно инициализироваться "
"после отключения питания d3cold. Это удерживает чип в состоянии d3hot (PCIe-"
"соединение активно) во время приостановки."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 124
#: usr/share/biglinux/biglinux-settings/sleep_page.py:161
msgid "Display and Keyboard"
msgstr "Дисплей и клавиатура"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 125
#: usr/share/biglinux/biglinux-settings/sleep_page.py:162
msgid "Preserve brightness and LED state across suspend."
msgstr "Сохранять яркость и состояние светодиода при приостановке."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 132
#: usr/share/biglinux/biglinux-settings/sleep_page.py:169
msgid "Save/restore brightness on suspend"
msgstr "Сохранить/восстановить яркость при приостановке"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 134
#: usr/share/biglinux/biglinux-settings/sleep_page.py:171
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores them"
" on resume."
msgstr ""
"Сохраняет яркость экрана и светодиоды клавиатуры перед приостановкой и "
"восстанавливает их при возобновлении."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 144
#: usr/share/biglinux/biglinux-settings/sleep_page.py:181
msgid "GNOME Shell Extensions"
msgstr "Расширения GNOME Shell"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 145
#: usr/share/biglinux/biglinux-settings/sleep_page.py:182
msgid "Automatic health check after resume."
msgstr "Автоматическая проверка состояния после возобновления."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 152
#: usr/share/biglinux/biglinux-settings/sleep_page.py:189
msgid "Extension health monitor"
msgstr "Монитор состояния расширений"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 154
#: usr/share/biglinux/biglinux-settings/sleep_page.py:191
msgid ""
"Detects GNOME Shell extensions in error state after resume and automatically "
"restarts them."
msgstr ""
"Обнаруживает расширения GNOME Shell в состоянии ошибки после возобновления и "
"автоматически перезапускает их."

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 163
#: usr/share/biglinux/biglinux-settings/sleep_page.py:200
msgid "Lid Switch"
msgstr "Выключатель крышки"

# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 164
#: usr/share/biglinux/biglinux-settings/sleep_page.py:201
msgid "Laptop lid close behavior."
msgstr "Поведение при закрытии крышки ноутбука."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:208
msgid "Keep running with the lid closed while plugged in"
msgstr "Продолжать работу с закрытой крышкой при питании от сети"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:210
msgid ""
"Keeps the session and network active when the lid is closed on AC power."
msgstr ""
"Сеанс и сетевое подключение остаются активными при закрытии крышки во время "
"работы от сети."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:216
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate. Keep the notebook ventilated while it runs with the lid "
"closed."
msgstr ""
"Эта настройка предотвращает переход в спящий режим и блокировку при закрытии "
"крышки. Автоматическая блокировка при бездействии настраивается отдельно. "
"Обеспечьте достаточную вентиляцию ноутбука во время его работы с закрытой "
"крышкой."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:224
msgid "Keep running with the lid closed on battery"
msgstr "Продолжать работу с закрытой крышкой при питании от аккумулятора"

#: usr/share/biglinux/biglinux-settings/sleep_page.py:226
msgid ""
"Keeps the session and network active when the lid is closed on battery power."
msgstr ""
"Сеанс и сетевое подключение остаются активными при закрытии крышки во время "
"работы от аккумулятора."

#: usr/share/biglinux/biglinux-settings/sleep_page.py:232
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate, and the 20% critical battery policy still applies."
msgstr ""
