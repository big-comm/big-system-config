# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/system_usability_page.py, line: 177
#: usr/share/biglinux/biglinux-settings/performance_page.py:76
msgid ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high "
"performance but removing automatic protections against system crashes."
msgstr ""
"Отключает аппаратный сторожевой таймер и системы тактирования TSC, "
"поддерживая высокую производительность, но удаляя автоматические защиты от "
"сбоев системы."

# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 81
#: usr/share/biglinux/biglinux-settings/performance_page.py:81
msgid ""
"This will disable the hardware watchdog. Your system will no longer "
"automatically recover from certain types of crashes. Are you sure you want to"
" continue?"
msgstr ""
"Это отключит аппаратный сторожевой таймер. Ваша система больше не будет "
"автоматически восстанавливаться после определенных типов сбоев. Вы уверены, "
"что хотите продолжить?"

